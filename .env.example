WECHAT_BOT_ENVIRONMENT=development
WECHAT_BOT_DATABASE_URL=postgresql+psycopg://wechat_bot:change-me@127.0.0.1:5432/wechat_bot
WECHAT_BOT_PUBLIC_BASE_URL=http://127.0.0.1:8000
WECHAT_BOT_GEWE_API_BASE_URL=http://api.geweapi.com
WECHAT_BOT_MASTER_KEY=
WECHAT_BOT_LOG_LEVEL=INFO
WECHAT_BOT_DIRECTORY_CONTACTS_CACHE_POLL_ATTEMPTS=6
WECHAT_BOT_DIRECTORY_CONTACTS_CACHE_POLL_INTERVAL_SECONDS=10

# Set only before creating the first Owner, then remove it after bootstrap succeeds.
# The random value must contain at least 32 characters. There is no default token.
# WECHAT_BOT_AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-value-of-at-least-32-characters

POSTGRES_DB=wechat_bot
POSTGRES_USER=wechat_bot
POSTGRES_PASSWORD=change-me
